<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F4"
    tools:context=".PerfilActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra superior (Toolbar) -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarPerfil"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/naranja"
            app:titleTextColor="@color/white" />

        <!-- Contenedor principal con padding -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgPerfil"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/naranja"
                android:contentDescription="Foto de Perfil" />


            <Button
                android:id="@+id/btnCambiarFoto"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Cambiar foto"
                android:textColor="@color/naranja"
                android:textSize="12sp" />

            <!-- TARJETA 1: MOSTRAR INFORMACIÓN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInfoDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:contentPadding="16dp"
                android:visibility="visible"> <!-- Esta es visible por defecto -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre"
                        android:textSize="12sp"
                        android:textColor="#888" />

                    <TextView
                        android:id="@+id/tvNombreUsuarioPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Cargando..."
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email"
                        android:textSize="12sp"
                        android:textColor="#888" />

                    <TextView
                        android:id="@+id/tvEmailUsuarioPerfil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="cargando@email.com"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginBottom="16dp"/>

                    <!-- (Aquí puedes agregar "Descripción", "Teléfono", etc. cuando los tengas) -->

                    <Button
                        android:id="@+id/btnEditarPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Editar Perfil"
                        android:backgroundTint="@color/naranja"
                        android:textColor="@color/white" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- TARJETA 2: EDITAR INFORMACIÓN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInfoEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:contentPadding="16dp"
                android:visibility="gone"> <!-- Esta está oculta por defecto -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nombre"
                        android:textSize="12sp"
                        android:textColor="#888" />

                    <EditText
                        android:id="@+id/etNombreEditar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Escribe tu nombre"
                        android:inputType="textPersonName"
                        android:textSize="18sp"
                        android:layout_marginBottom="16dp"/>

                    <!-- (Aquí puedes agregar un EditText para "Descripción") -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnCancelarEdicion"

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Cancelar"
                            android:textColor="@color/naranja"
                            android:layout_marginEnd="8dp"/>

                        <Button
                            android:id="@+id/btnGuardarCambios"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Guardar"
                            android:backgroundTint="@color/naranja"
                            android:textColor="@color/white"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Botón de Cerrar Sesión (fuera de las tarjetas) -->
            <Button
                android:id="@+id/btnCerrarSesionPerfil"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Cerrar Sesión"
                android:backgroundTint="@color/naranja"
                android:textColor="@color/white"
                app:strokeColor="#E53935"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>