<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/fondo1"
    tools:context=".InitionActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        >


        <!-- Header  saludo personalizado -->
        <androidx.cardview.widget.CardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/naranja"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content">

                    <!--  Texto extraído y ID agregado -->
                    <TextView
                        android:id="@+id/tvBienvenidaHeader"
                        android:text="@string/inicio_hola_estudiante"
                        tools:text="Hola Estudiante"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <!-- ¡CAMBIO! Texto extraído y ID agregado -->
                    <TextView
                        android:id="@+id/tvSubtituloHeader"
                        android:text="@string/inicio_listo_aprender"
                        tools:text="Listo para aprender"
                        android:textColor="#FFF3E0"
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" />

                </LinearLayout>

                <!--  Se agregó ID para la foto de perfil -->
                <ImageView
                    android:id="@+id/ivHeaderProfilePic"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@android:drawable/ic_menu_compass"
                    app:tint="@color/white"
                    android:contentDescription="Foto de perfil" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Progreso diario con animación visual -->
        <androidx.cardview.widget.CardView
            android:id="@+id/progressCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/headerCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="15dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_today"
                        android:layout_marginEnd="10dp"
                        app:tint="@color/naranja"
                        android:contentDescription="Icono de progreso" />

                    <!--  Texto extraído -->
                    <TextView
                        android:text="@string/inicio_progreso_hoy"
                        tools:text="Tu progreso hoy"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/naranja"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBarDaily"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progress="65"
                    android:progressTint="@color/naranja"
                    android:progressBackgroundTint="#E0E0E0"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--  Texto extraído -->
                    <TextView
                        android:text="@string/inicio_racha"
                        tools:text="racha"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/txtStreakCount"
                        android:text="🔥5"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/naranja"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp" />

                    <!--  Texto extraído -->
                    <TextView
                        android:text="@string/inicio_puntos"
                        tools:text="Puntos"
                        android:textSize="12sp"
                        android:textColor="#666666"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp" />

                    <TextView
                        android:id="@+id/txtPointsCount"
                        android:text="⭐ 1,250"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FAD169"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Acciones principales con cards interactivas -->
        <LinearLayout
            android:id="@+id/actionsLayout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/progressCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Lección principal -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardEmpezarLeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/naranja"
                android:layout_marginBottom="15dp"
                android:foreground="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:orientation="horizontal"
                    android:padding="20dp"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <!--  Texto extraído y ID agregado -->
                        <TextView
                            android:id="@+id/tvLeccionTitulo"
                            android:text="@string/inicio_continuar_leccion"
                            tools:text="Continuar lección"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <!--  Texto extraído y ID agregado -->
                        <TextView
                            android:id="@+id/tvLeccionDetalle"
                            android:text="@string/inicio_leccion_detalle"
                            tools:text="Lección 5 presente simple"
                            android:textColor="#FFF3E0"
                            android:textSize="14sp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp" />

                        <!--  Texto extraído y ID agregado -->
                        <TextView
                            android:id="@+id/tvLeccionProgreso"
                            android:text="@string/inicio_leccion_progreso"
                            tools:text="Progreso 75 completado"
                            android:textColor="#FAD169"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" />

                    </LinearLayout>

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@android:drawable/ic_media_play"
                        android:padding="15dp"
                        app:tint="@color/white"
                        android:contentDescription="play_lesson" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Grid de opciones secundarias -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProgreso"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="120dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#E3F2FD"
                    android:layout_marginEnd="10dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="15dp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_info_details"
                            android:layout_marginBottom="10dp"
                            app:tint="@color/naranja"
                            android:contentDescription="Icono de progreso" />

                        <!--  Texto extraído y ID agregado -->
                        <TextView
                            android:id="@+id/tvProgresoLabel"
                            android:text="@string/inicio_mi_progreso"
                            tools:text="Mi progreso"
                            android:textColor="@color/naranja"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPerfil"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="120dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#E8F5E8"
                    android:layout_marginStart="10dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="15dp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@android:drawable/ic_menu_edit"
                            android:layout_marginBottom="10dp"
                            app:tint="@color/naranja"
                            android:contentDescription="Icono de perfil" />

                        <!--  Texto extraído y ID agregado -->
                        <TextView
                            android:id="@+id/tvPerfilLabel"
                            android:text="@string/inicio_perfil"
                            tools:text="Perfil"
                            android:textColor="@color/naranja"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Opciones adicionales -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardComunidad"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFF8E1"
                    android:layout_marginEnd="7dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">



                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@android:drawable/ic_menu_search"
                            android:layout_marginBottom="8dp"
                            app:tint="@color/naranja"
                            android:contentDescription="Icono de comunidad" />

                        <!--  Texto extraído y ID agregado -->
                        <TextView
                            android:id="@+id/tvComunidadLabel"
                            android:text="@string/inicio_comunidad"
                            tools:text="Comunidad"
                            android:textColor="@color/naranja"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardGames"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#F3E5F5"
                    android:layout_marginStart="7dp"
                    android:layout_marginEnd="7dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@android:drawable/ic_menu_myplaces"
                            android:layout_marginBottom="8dp"
                            app:tint="@color/naranja"
                            android:contentDescription="Icono de juegos" />

                        <!--  Texto extraído y ID agregado -->
                        <TextView
                            android:id="@+id/tvJuegosLabel"
                            android:text="@string/inicio_juegos"
                            tools:text="Juegos"
                            android:textColor="@color/naranja"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardConfiguracion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="#FFEBEE"
                    android:layout_marginStart="7dp"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:src="@android:drawable/ic_menu_preferences"
                            android:layout_marginBottom="8dp"
                            app:tint="@color/naranja"
                            android:contentDescription="Icono de ajustes" />

                        <!--  Texto extraído, ID agregado y 'androids'  -->
                        <TextView
                            android:id="@+id/tvAjustesLabel"
                            android:text="@string/inicio_ajustes"
                            tools:text="Ajustes"
                            android:textColor="@color/naranja"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

        <!-- Motivación diaria -->
        <androidx.cardview.widget.CardView
            android:id="@+id/motivationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FAD169"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/actionsLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:orientation="horizontal"
                android:padding="15dp"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!--  Texto extraído y ID agregado -->
                <TextView
                    android:id="@+id/tvTipEmoji"
                    tools:text="💡"
                    android:textSize="24sp"
                    android:layout_marginEnd="15dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <!--  Texto extraído y ID agregado -->
                <TextView
                    android:id="@+id/tvTipDelDia"
                    android:text="@string/inicio_tip_del_dia"
                    tools:text="Tip del dia practica 5 minutos"
                    android:textColor="@color/naranja"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>