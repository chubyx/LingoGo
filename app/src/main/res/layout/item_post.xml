<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPostAutor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Nombre del Autor" />

                <TextView
                    android:id="@+id/tvPostTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    tools:text="10/11/2025 a las 14:30" />

            </LinearLayout>

            <!-- ¡NUEVO! Botón de Borrar Post -->
            <ImageView
                android:id="@+id/ivDeletePost"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#E53935"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="Borrar post" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPostTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="14sp"
            tools:text="Este es el contenido del post. Puede ser un texto de varias líneas donde el usuario escribe sus dudas o comparte su progreso." />

    </LinearLayout>

</androidx.cardview.widget.CardView>