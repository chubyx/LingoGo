<?xml version="1.0" encoding="utf-8"?>
<!-- ¡CAMBIO! Se cambió a ConstraintLayout para superponer vistas -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E5DDD5"
    tools:context=".GroupChatActivity">

    <!-- Barra de Aplicación -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarGroupChat"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/naranja"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Lista de Mensajes (Oculta por defecto) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGroupChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/toolbarGroupChat"
        app:layout_constraintBottom_toTopOf="@id/inputLayout"
        tools:listitem="@layout/item_group_message_received" />

    <!-- Input para Escribir (Oculto por defecto) -->
    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etGroupChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escribe un mensaje..."
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:padding="12dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnGroupSendMessage"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@android:drawable/ic_menu_send"
            android:backgroundTint="@color/naranja"
            android:enabled="false"
            tools:enabled="true"/>
    </LinearLayout>

    <!-- ¡NUEVO! Layout para "Unirse al Grupo" (Visible por defecto) -->
    <LinearLayout
        android:id="@+id/layoutJoinGroup"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#E5DDD5"
        android:visibility="visible"
        tools:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbarGroupChat"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvJoinGroupName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unirte a..."
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="16dp"
            android:gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Únete a la conversación para ver los mensajes y participar!"
            android:textSize="16sp"
            android:textColor="#333333"
            android:layout_marginBottom="24dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnJoinGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unirme al Grupo"
            android:backgroundTint="@color/naranja"
            android:textColor="@color/white"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>