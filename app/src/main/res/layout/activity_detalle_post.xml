<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F4F4"
    tools:context=".DetallePostActivity">

    <!-- Barra de Aplicación -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarDetallePost"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/naranja"
        app:titleTextColor="@color/white" />

    <!-- Contenido (Post + Comentarios) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Post Original (Arriba) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPostOriginal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="4dp"
            app:layout_constraintTop_toTopOf="parent"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvDetallePostAutor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Nombre del Autor" />

                <TextView
                    android:id="@+id/tvDetallePostTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp"
                    tools:text="10/11/2025 a las 14:30" />

                <TextView
                    android:id="@+id/tvDetallePostTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    tools:text="Este es el contenido del post original. Aquí el usuario explica su duda o comparte su progreso con la comunidad." />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Divisor -->
        <TextView
            android:id="@+id/tvTituloComentarios"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comentarios"
            android:textStyle="bold"
            android:textColor="@color/naranja"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardPostOriginal"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Lista de Comentarios (Medio) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvComentarios"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvTituloComentarios"
            app:layout_constraintBottom_toTopOf="@id/inputLayout"
            />

        <!-- Input para nuevo comentario (Abajo) -->
        <LinearLayout
            android:id="@+id/inputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:background="@color/white"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent">

            <EditText
                android:id="@+id/etEscribirComentario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Escribe un comentario..."
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:padding="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnEnviarComentario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enviar"
                android:backgroundTint="@color/naranja"
                android:textColor="@color/white"
                android:enabled="false"
                tools:enabled="true"/>
        </LinearLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>