<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/fondo2"
    tools:context=".CommunityActivity">

    <!-- Barra de Aplicación -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Toolbar (Tu diseño) -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarCommunity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/orange_700"
            app:title="Comunidad LingoGo"
            app:titleTextColor="@color/white" />

        <!-- Tabs (Tu diseño) -->
        <LinearLayout
            android:id="@+id/tabsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFF8E1"
            android:orientation="horizontal"

            android:padding="15dp">

            <Button
                android:id="@+id/btnTabChats"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FAD169"
                android:text="Chats"
                android:textColor="@color/naranja"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTabGrupos"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1"
                android:backgroundTint="#FAD169"
                android:text="Grupos"
                android:textColor="@color/naranja"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTabForo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:backgroundTint="@color/naranja"
                android:text="Foro"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!--
      ¡CAMBIO IMPORTANTE!
      Añadimos un FrameLayout para superponer las dos listas
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Lista de Posts (Foro) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPosts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:visibility="gone"
            tools:listitem="@layout/item_post" />

        <!-- Lista de Salas de Chat (Chats) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChatRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:visibility="gone"
            tools:listitem="@layout/item_chat_room" />

        <!-- ¡NUEVO! Lista de Salas de Grupo (Grupos) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroupRooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:visibility="gone"
            tools:listitem="@layout/item_chat_room" /> <!-- Reutilizamos el layout de item_chat_room -->

    </FrameLayout>


    <!-- Botón Flotante para Crear Post -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCrearPost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Crear nuevo post"
        android:src="@android:drawable/ic_menu_edit"
        android:visibility="gone"
        app:backgroundTint="@color/naranja"
        app:tint="@color/white" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>