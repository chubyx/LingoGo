<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/fondo2"
    tools:context=".CommunityActivity">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarCommunity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/naranja"
            app:title="Comunidad LingoGo"
            app:titleTextColor="@color/white" />


        <LinearLayout
            android:id="@+id/tabsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="15dp"
            android:background="#FFFFFF">

            <Button
                android:id="@+id/btnTabChats"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Chats"
                android:textColor="@color/naranja"
                android:backgroundTint="#FAD169"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTabGrupos"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:text="Grupos"
                android:textColor="@color/naranja"
                android:backgroundTint="#FAD169"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTabForo"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Foro"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/naranja"
                android:textSize="14sp" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPosts"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_post" />


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCrearPost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_menu_edit"
        app:backgroundTint="@color/naranja"
        app:tint="@color/white"
        android:contentDescription="Crear nuevo post" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>